{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "NODE_OPTIONS=--env-file=.env tsx watch src/index.ts",
    "dev:qa": "NODE_OPTIONS=--env-file=.env.qa tsx watch src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env.production dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:push:qa": "npx dotenv-cli -e .env.qa -- prisma db push",
    "db:push:prod": "npx dotenv-cli -e .env.production -- prisma db push"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@prisma/client": "^6.19.3",
    "firebase-admin": "^14.2.0",
    "hono": "^4.12.33",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "prisma": "^6.19.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
